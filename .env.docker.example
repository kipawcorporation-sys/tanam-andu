# ==============================================================================
# Plant For Fun — Konfigurasi Lingkungan Docker / Proxmox (.env)
# Salin file ini menjadi .env sebelum menjalankan 'docker compose up -d'
# ==============================================================================

# Aplikasi
APP_NAME="Plant For Fun"
APP_TAGLINE="Kerenceng Coffee Planting & Agroforestry Expedition"
APP_ENV=production
APP_DEBUG=false
APP_URL="http://IP_PROXMOX_ANDA:8000"
APP_PORT=8000
APP_TIMEZONE="Asia/Jakarta"
APP_LOCALE="id"

# Database MySQL / MariaDB (Host container: db)
DB_HOST="db"
DB_PORT="3306"
DB_DATABASE="tanampohon_db"
DB_USERNAME="root"
DB_PASSWORD="root"
DB_CHARSET="utf8mb4"
DB_PREFIX=""
DB_PORT_FORWARD=3307

# Pengaturan Pembayaran Manual (Transfer Bank / E-Wallet / QRIS)
PAYMENT_DEADLINE_HOURS=24
UNIQUE_CODE_ENABLED=true
UNIQUE_CODE_MIN=100
UNIQUE_CODE_MAX=999

# Pengaturan Email (PHPMailer / SMTP)
MAIL_DRIVER=smtp
MAIL_HOST="smtp.mailtrap.io"
MAIL_PORT=2525
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_ENCRYPTION="tls"
MAIL_FROM_ADDRESS="no-reply@tanampohon.id"
MAIL_FROM_NAME="TanamPohon.id"
ADMIN_EMAIL="admin@tanampohon.id"

# Notifikasi WhatsApp (Fonnte API)
# Dapat diatur langsung di panel /admin/pengaturan
WA_GATEWAY_URL="https://api.fonnte.com/send"
WA_GATEWAY_API_KEY=""
WA_GATEWAY_SENDER=""
ADMIN_WHATSAPP="081234567890"

# Pengaturan Ongkos Kirim (RajaOngkir / Biteship / Manual)
RAJAONGKIR_API_KEY=""
RAJAONGKIR_TYPE="starter"
RAJAONGKIR_ORIGIN_CITY_ID="151"
BITESHIP_API_KEY=""

# Upload File (Ukuran maksimal byte: 25MB = 26214400)
MAX_UPLOAD_SIZE=26214400

# Keamanan & Otomasi Cron Job Terjadwal
CRON_SECRET_TOKEN="tanampohon_secret_cron_token_2026"

