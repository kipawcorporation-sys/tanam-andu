# ==============================================================================
# TanamPohon.id - Konfigurasi Lingkungan (.env)
# ==============================================================================

# Aplikasi
APP_NAME="TanamPohon.id"
APP_TAGLINE="Donasi Pohon untuk Bumi yang Lebih Hijau"
APP_ENV=local
APP_DEBUG=true
APP_URL="http://localhost:8000"
APP_TIMEZONE="Asia/Jakarta"
APP_LOCALE="id"

# Database MySQL / MariaDB
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_DATABASE="tanampohon_db"
DB_USERNAME="root"
DB_PASSWORD=""
DB_CHARSET="utf8mb4"
DB_PREFIX=""

# Pengaturan Pembayaran Manual (Transfer Bank / E-Wallet / QRIS)
# TIDAK ADA PAYMENT GATEWAY / API PEMBAYARAN OTOMATIS
PAYMENT_DEADLINE_HOURS=24
UNIQUE_CODE_ENABLED=true
UNIQUE_CODE_MIN=100
UNIQUE_CODE_MAX=999

# Pengaturan Email (PHPMailer / SMTP)
MAIL_DRIVER=smtp
MAIL_HOST="smtp.mailtrap.io"
MAIL_PORT=2525
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_ENCRYPTION="tls"
MAIL_FROM_ADDRESS="no-reply@tanampohon.id"
MAIL_FROM_NAME="TanamPohon.id"
ADMIN_EMAIL="admin@tanampohon.id"

# Notifikasi WhatsApp (Adapter Gateway Fonnte / sejenis)
WA_GATEWAY_URL="https://api.fonnte.com/send"
WA_GATEWAY_API_KEY=""
WA_GATEWAY_SENDER=""
ADMIN_WHATSAPP="081234567890"

# Pengaturan Ongkos Kirim (RajaOngkir / Biteship / Manual)
RAJAONGKIR_API_KEY=""
RAJAONGKIR_TYPE="starter"
RAJAONGKIR_ORIGIN_CITY_ID="151" # Jakarta Barat contoh
BITESHIP_API_KEY=""

# Upload File
MAX_UPLOAD_SIZE=2097152 # 2 MB (sesuai spesifikasi untuk bukti transfer)

# Keamanan & Otomasi Cron Job Terjadwal (Web Hook Token)
CRON_SECRET_TOKEN="ganti_dengan_token_rahasia_anda_12345"

