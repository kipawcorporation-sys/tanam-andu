{
    "name": "tanampohon/tanampohon-app",
    "description": "Platform Donasi Pohon, Relawan, dan Penjualan Merchandise dengan Pembayaran Manual",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "Senior Full-Stack PHP Developer",
            "email": "dev@tanampohon.id"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-gd": "*",
        "ext-curl": "*",
        "dompdf/dompdf": "^2.0 || ^3.0",
        "phpmailer/phpmailer": "^6.8",
        "endroid/qr-code": "^4.8 || ^5.0",
        "phpoffice/phpspreadsheet": "^1.29 || ^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}

